/* =========================================================
   eat-what 全局样式
   设计基准：最终原型 iPhone X 375pt × 812pt → 750rpx（1px = 2rpx）
   ========================================================= */
page {
  --c-bg: #FAF3E9;
  --c-primary: #E2622F;
  --c-grad-light: #F6B57A;
  --c-ink: #3D2A1E;
  --c-ink-2: #8A7666;
  --c-ink-3: #BBA896;
  --c-line: #EBDBC9;
  --c-surface: #F5EADB;
  --c-dark: #45301F;
  --c-ring: #E5C9A5;
  --c-track: #F0E2CE;
  /* 夜间模式 token（字体不变，仅换色）：
     标题 #F5E4CE / 正文 #D9C8B4。接入夜间 UI（深色背景一起换）时再启用 .theme-dark */
  --c-ink-night: #F5E4CE;
  --c-body-night: #D9C8B4;

  background: var(--c-bg);
  color: var(--c-ink);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
  -webkit-tap-highlight-color: transparent;
}

view, text, image, button, input, textarea, scroll-view, navigator {
  box-sizing: border-box;
}

/* 标题衬线字体（奖池大字 / 菜名） */
.font-serif {
  font-family: "Songti SC", "STSong", "SimSun", "Source Han Serif SC", serif;
}

/* 品牌标题字体：站酷快乐体。
   @font-face 定义在「本文件末尾的 BRAND FONT 区块」—— 字体子集已 base64 内联，
   渲染即可用（不依赖网络 / 域名白名单），所以不用等任何异步回调。
   font-family 里保留 sans-serif 兜底，万一字体缺失也只是回退系统字体。
   ZCOOL KuaiLe 只有 Regular 字重 —— 标题类统一不加粗，避免系统伪加粗变形。 */
.font-brand {
  font-family: "ZCOOL KuaiLe", "PingFang SC", "Noto Sans SC", sans-serif;
  font-weight: 400;
}

/* 夜间模式（预留）：仅换文字颜色，字体不变。
   注意：需与深色背景方案一起启用，单独开会导致浅底浅字不可读。
   用法：给 page 根节点挂 theme-dark 类（或配合 darkmode 主题配置）。 */
.theme-dark {
  --c-ink: var(--c-ink-night);      /* 标题 #F5E4CE */
  --c-ink-2: var(--c-body-night);   /* 正文 #D9C8B4 */
  --c-ink-3: var(--c-body-night);
}

/* 页面根容器：定高 100vh，内容内部滚动。
   刻意不设 z-index —— 一旦设了就成层叠上下文，tab / 目标元素再也抬不到引导蒙层之上。 */
.page-root {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.page-scroll { flex: 1; height: 0; }

/* 状态栏占位（高度由 JS 按机型写入） */
.status-holder { width: 100%; flex-shrink: 0; }

/* 页面底部留白（给悬浮导航让位） */
.pad-bottom { height: 256rpx; flex-shrink: 0; }

/* =========================================================
   底部导航：四等分 + 中间突起添加钮
   ========================================================= */
.tabbar {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  height: 124rpx;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 62rpx;
  box-shadow: 0 24rpx 60rpx -16rpx rgba(69, 48, 31, .2);
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  /* 注意：这里刻意不设 z-index。
     tabbar 一旦设了 z-index 就会成层叠上下文，内部 tab 再也无法抬到引导蒙层之上。 */
}
.tab {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  position: relative;
  background: transparent;
  transition: background .18s;
}
/* IP 萌宠风格 tab：透明水彩图标 + 淡橙选中（无边框） */
.tab__icon {
  width: 64rpx;
  height: 64rpx;
  filter: drop-shadow(0 4rpx 6rpx rgba(69, 48, 31, .26));
  transition: transform .18s, filter .18s, opacity .18s;
}
.tab__label { font-size: 20rpx; line-height: 1; color: var(--c-ink-3); transition: color .18s; }
.tab.is-active { background: rgba(226, 98, 47, .11); }
.tab.is-active .tab__icon {
  transform: scale(1.06);
  filter: drop-shadow(0 6rpx 12rpx rgba(226, 98, 47, .34));
}
.tab.is-active .tab__label { color: var(--c-primary); font-weight: 600; }

.tab--add { background: transparent !important; }
.tab--add .tab__fab {
  position: absolute;
  left: 50%;
  top: -40rpx;
  transform: translateX(-50%);
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--c-grad-light), var(--c-primary));
  box-shadow: 0 20rpx 40rpx -10rpx rgba(226, 98, 47, .5), 0 0 0 6rpx #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab--add .tab__plus { position: relative; width: 32rpx; height: 32rpx; }
.tab--add .tab__plus::before,
.tab--add .tab__plus::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 3rpx;
}
.tab--add .tab__plus::before { left: 0; top: 50%; width: 100%; height: 5rpx; margin-top: -2.5rpx; }
.tab--add .tab__plus::after { top: 0; left: 50%; height: 100%; width: 5rpx; margin-left: -2.5rpx; }
.tab--add .tab__label { position: absolute; left: 0; right: 0; top: 57rpx; text-align: center; }

/* =========================================================
   IP 萌宠：tab 栏上方的对话入口（仅首页显示）
   ========================================================= */
.ip-pet {
  position: absolute;
  right: 36rpx;
  bottom: calc(212rpx + env(safe-area-inset-bottom));
  z-index: 101;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
  /* 容器不吃点击：热区只留在小猫身上（.ip-pet__hit），
     避免透明区域盖住【开始】【记入饮食】按钮 */
  pointer-events: none;
}
.ip-pet__bubble {
  position: absolute;          /* 浮层：不占流，等级泡进来后总高基本不变 */
  z-index: 2;                  /* 显示层在小猫上面（DOM 在猫之前，须显式抬高） */
  right: 94rpx;                /* 挂在小猫左侧面颊旁（v2.7 再左移 5px），重叠一点猫身没关系 */
  bottom: 60rpx;
  width: max-content;          /* 父容器 .ip-pet 宽度窄，shrink-to-fit 会挤成竖排，须显式撑开 */
  max-width: 480rpx;           /* 自适应限宽：约 15 字/行，最多两行截断，防长猫语溢出屏 */
  background: #fff;
  border: 2rpx solid var(--c-line);
  color: var(--c-ink);
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 23rpx;
  padding: 16rpx 24rpx;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  box-shadow: 0 20rpx 48rpx -16rpx rgba(69, 48, 31, .28);
  animation: pet-float 2.6s ease-in-out infinite;
  transition: opacity .45s ease;
  box-sizing: border-box;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
/* 3s 后气泡淡出（停掉浮动动画，避免 transform 冲突） */
.ip-pet__bubble.is-out {
  animation: none;
  opacity: 0;
  pointer-events: none;
}
/* 常驻等级泡：占流，轻气泡样式，点击进喵屋 */
.ip-pet__lv {
  pointer-events: auto;        /* 父级 none，热区单独恢复 */
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, .92);
  border: 2rpx solid var(--c-line);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  box-shadow: 0 14rpx 30rpx -14rpx rgba(69, 48, 31, .25);
  animation: pet-float 2.6s ease-in-out infinite;
}
.ip-pet__lv-num {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 24rpx;
  color: var(--c-primary);
}
.ip-pet__lv-title {
  font-size: 20rpx;
  color: var(--c-ink-2);
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ip-pet__wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  filter: drop-shadow(0 20rpx 28rpx rgba(226, 98, 47, .38));
  animation: pet-bounce 2.6s ease-in-out infinite;
}
/* 点击热区：按小猫素材的不透明边界收窄（猫身/猫头 bbox 实测），
   重新开启 pointer-events（父级为 none 时子级可恢复） */
.ip-pet__hit {
  position: absolute;
  left: 11%;
  right: 10%;
  top: 2%;
  bottom: 0;
  border-radius: 46%;
  pointer-events: auto;
  z-index: 2;
}
.ip-pet__img,
.ip-pet__head,
.ip-pet__eyes {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
/* 头部层绕颈部摆动 —— 耳朵微动 */
.ip-pet__head {
  transform-origin: 50% 60%;
  animation: pet-ear 3.2s ease-in-out infinite;
}
/* 眼睑层：静止时与上方毛发完全重合（隐形），下滑即眨眼 */
.ip-pet__eyes { transform: translateY(-11.05%); animation: pet-blink 4.4s ease-in-out infinite; }
@keyframes pet-blink {
  0%, 87%   { transform: translateY(-11.05%); }
  90%       { transform: translateY(0); }
  93%, 100% { transform: translateY(-11.05%); }
}
@keyframes pet-ear {
  0%, 26%, 100% { transform: rotate(0deg); }
  8%  { transform: rotate(-3.2deg); }
  17% { transform: rotate(2.2deg); }
  62% { transform: rotate(2.6deg); }
  78% { transform: rotate(-1.6deg); }
}
@keyframes pet-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14rpx); } }
@keyframes pet-float  { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6rpx); } }

/* =========================================================
   ① 首页
   ========================================================= */
.home-screen { display: flex; flex-direction: column; align-items: center; }
.seg {
  margin-top: 32rpx;
  display: flex;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 46rpx;
  padding: 8rpx;
}
.seg__item {
  padding: 18rpx 56rpx;
  border-radius: 38rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  color: #BBA896;    /* 未选中：弱化色 */
  transition: all .2s;
}
.seg__item.is-on {
  background: var(--c-primary);
  color: #FFFFFF;    /* 选中：白字 */
  font-weight: 400;
  box-shadow: 0 12rpx 28rpx -8rpx rgba(226, 98, 47, .5);
}
.pool-zone {
  margin-top: 64rpx;
  width: 540rpx;
  height: 540rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pool {
  position: relative;
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  box-shadow: 0 44rpx 88rpx -32rpx rgba(226, 98, 47, .4);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 手绘餐盘：待机静态（动画暂停在当前角度），仅开奖时旋转 */
.pool__plate {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: pool-spin 1.2s linear infinite;
  animation-play-state: paused;
}
.pool.is-rolling .pool__plate { animation-play-state: running; }
@keyframes pool-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
/* 盘上大字：站酷快乐体，墨色，居中，字距 2rpx；按字数分档自适应，超宽自动换行。
   内圈（可书写区）直径 304rpx，单行预算 282rpx —— 各档宽度已用真字体实测。 */
.pool__name {
  position: relative;
  z-index: 1;
  max-width: 280rpx;
  /* 待机「今天吃什么」= 品牌字体（.is-brand）；开奖后是用户菜名 → 系统字体，
     避免子集缺字造成逐字混排 */
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 52rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
  color: #3D2A1E;
}
/* 待机态固定文案「今天吃什么」用品牌字体（结果态是用户内容，走系统字体） */
.pool__name.is-brand { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; }
.pool__name.is-xl { font-size: 68rpx; }  /* 1-3 字 */
.pool__name.is-lg { font-size: 60rpx; }  /* 4 字 */
.pool__name.is-md { font-size: 52rpx; }  /* 5 字（含待机「今天吃什么」） */
.pool__name.is-sm { font-size: 42rpx; }  /* 6-7 字，7 字换行 */
.pool__name.is-xs { font-size: 34rpx; }  /* 8 字以上，换行 */
.home-actions {
  width: 100%;
  padding: 0 68rpx;
  margin-top: 104rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.btn-main {
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(160deg, var(--c-grad-light), var(--c-primary));
  color: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 24rpx 48rpx -12rpx rgba(226, 98, 47, .42);
  transition: filter .2s;
}
.btn-main.is-rolling .paw-ico { opacity: .9; }
/* 开奖中的按钮底色/呼吸由 pages/home/home.wxss 定义（浅白灰 + 中性阴影） */
/* 出结果后【再来一次】：稍微置灰一点点 */
.btn-main.is-dim { filter: saturate(.55) brightness(.96); }
/* 【开始】左侧手绘猫爪 */
.btn-main__txt { letter-spacing: 12rpx; margin-right: -12rpx; }
.paw-ico { width: 46rpx; height: 42rpx; flex-shrink: 0; margin-bottom: 2rpx; }
.btn-main.is-rolling .paw-ico { opacity: .9; }
.btn-ghost {
  height: 100rpx;
  border-radius: 50rpx;
  background: #fff;
  border: 2rpx solid var(--c-line);
  color: var(--c-ink-2);
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 29rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-ghost.is-result {
  background: linear-gradient(160deg, var(--c-grad-light), var(--c-primary));
  border-color: transparent;
  color: #fff;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* =========================================================
   ② 我的饮食手札：hero 与页面背景溶于一体，右侧 IP 萌宠探出
   ========================================================= */
.page-title {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 400;
  padding: 12rpx 40rpx 0;
}
.profile-hero {
  position: relative;
  margin: 16rpx 40rpx 0;
  padding: 32rpx 0 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.profile-hero__glow {
  position: absolute;
  right: -72rpx;
  top: -60rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(246, 181, 122, .20), rgba(246, 181, 122, 0) 68%);
}
.profile-hero__txt { position: relative; z-index: 1; flex: 1; min-width: 0; }
.hero-title {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 46rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  color: var(--c-ink);
  line-height: 1.2;
}
.hero-title__accent { color: var(--c-primary); }
.hero-rule { margin-top: 20rpx; width: 184rpx; border-top: 4rpx dashed rgba(226, 98, 47, .4); }
/* 日期星期为主（明显放大），具体时间弱化为紧跟其后的小字 */
.hero-date {
  margin-top: 26rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 33rpx;
  font-weight: 400;
  color: var(--c-ink-2);
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}
.hero-date__clock { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 23rpx; font-weight: 400; color: var(--c-ink-3); letter-spacing: 1rpx; }
/* 头部信息块：左侧大字 + 右侧两行说明（原天气版式，现为时段 / 月份季节） */
.hero-wx { margin-top: 36rpx; display: flex; align-items: center; gap: 22rpx; }
.hero-wx__temp { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 50rpx; font-weight: 400; color: var(--c-ink); letter-spacing: 1rpx; line-height: 1.1; }
.hero-wx__col { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.hero-wx__r1 { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 25rpx; color: var(--c-ink-2); white-space: nowrap; }
.hero-wx__r2 { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 22rpx; color: var(--c-ink-3); white-space: nowrap; }
/* 右侧 IP 萌宠列 */
.hero-pet {
  width: 292rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-cat { height: 252rpx; width: 216rpx; filter: drop-shadow(0 20rpx 32rpx rgba(226, 98, 47, .15)); }
/* 每日饮食贴士：猫下方对话气泡 */
.pet-tip {
  position: relative;
  margin-top: 18rpx;
  width: 100%;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 26rpx;
  padding: 16rpx 20rpx 18rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--c-ink-2);
  text-align: center;
  box-shadow: 0 20rpx 40rpx -24rpx rgba(69, 48, 31, .35);
  transition: opacity .3s ease;
}
.pet-tip::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  margin-left: -10rpx;
  width: 18rpx;
  height: 18rpx;
  background: #fff;
  border-left: 2rpx solid var(--c-line);
  border-top: 2rpx solid var(--c-line);
  transform: rotate(45deg);
}
.pet-tip__tag {
  display: block;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  color: var(--c-primary);
  margin-bottom: 6rpx;
}
.pet-tip.is-hidden { opacity: 0; pointer-events: none; }

/* 时段首访小看板：吊在 IP 猫下方，以夹子为轴轻摆，点小猫爪收起 */
.tip-board {
  position: absolute;
  top: 344rpx;
  left: 50%;
  width: 376rpx;
  margin-left: -188rpx;
  z-index: 30;
  filter: drop-shadow(0 32rpx 52rpx rgba(69, 48, 31, .30));
}
.tb-swing {
  position: relative;
  transform-origin: 50% 12%;
  animation: tb-swing 3s ease-in-out infinite;
}
@keyframes tb-swing {
  0%   { transform: rotate(-1.8deg); }
  50%  { transform: rotate(1.8deg); }
  100% { transform: rotate(-1.8deg); }
}
.tip-board__paper { width: 100%; height: 462rpx; display: block; }  /* 432 + 30rpx(=15px)：看板加高（两轮累计 +5px / +10px） */
.tip-board__txt {
  position: absolute;
  left: 14%;
  right: 14%;
  top: 49%;
  height: 16%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6E4A2F;
  text-align: center;
}
.tip-board__paw {
  position: absolute;
  right: 11%;
  bottom: 5%;
  width: 27%;
  height: 27%;
  border-radius: 50%;
}
.tip-board__paw::after {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  top: 10%;
  bottom: 10%;
  border-radius: 50%;
  border: 4rpx dashed rgba(255, 255, 255, .8);
  animation: paw-pulse 1.5s ease-out infinite;
}
@keyframes paw-pulse {
  0% { transform: scale(.72); opacity: .95; }
  75%, 100% { transform: scale(1.12); opacity: 0; }
}
/* 收起提示：贴近纸面的浅色印字，展示 3s 后淡出 */
.tip-board__hint {
  position: absolute;
  right: 41%;
  bottom: 14%;
  width: 124rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 20rpx;
  line-height: 1.5;
  color: #FAF3E9;
  text-align: center;
  letter-spacing: 1rpx;
  text-shadow: 0 0 4rpx rgba(140, 105, 70, .25);
  transition: opacity .45s ease;
}
.tip-board.is-in { animation: tb-in .55s cubic-bezier(.34, 1.56, .64, 1) both; }
@keyframes tb-in {
  from { transform: scale(.5) translateY(36rpx); opacity: 0; }
  to   { transform: scale(1) translateY(0); opacity: 1; }
}
.tip-board.is-out { animation: tb-out .4s ease-in both; }
@keyframes tb-out {
  to { transform: scale(.45) translateY(-20rpx); opacity: 0; }
}

.card {
  margin: 28rpx 40rpx 0;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
}
.card__title {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 27rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
}
.card__hint { margin-left: auto; font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 21rpx; color: var(--c-ink-3); font-weight: 400; }

.slot-tabs { display: flex; gap: 12rpx; margin-top: 24rpx; }
.slot-tabs__item {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--c-line);
  background: #fff;
  color: var(--c-ink-2);
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 400;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.slot-tabs__item.is-on {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  font-weight: 400;
}
.slot-tabs__dot {
  position: absolute;
  right: 14rpx;
  top: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-grad-light);
}
.slot-tabs__item.is-on .slot-tabs__dot { background: #fff; }

.diet-scroll {
  height: 392rpx;
  margin-top: 24rpx;
  position: relative;
}
/* 非当前时段整段淡化：只做弱化，保证列表最上 / 最下时依然清晰可读 */
.slot-sec { padding-bottom: 6rpx; opacity: .62; }
.slot-sec.is-focus { opacity: 1; }
.slot-sec + .slot-sec { margin-top: 24rpx; border-top: 2rpx dashed var(--c-track); padding-top: 24rpx; }
.slot-sec__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 400;
  margin-bottom: 18rpx;
}
.slot-sec__head::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
}
.slot-empty { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; text-align: center; font-size: 24rpx; color: var(--c-ink-3); padding: 32rpx 0 36rpx; }

/* 空态虚线框（当前时段可行动时）：猫爪按钮 + 文案，点它去首页抽一个 */
.empty-banner {
  height: 208rpx;
  border-radius: 36rpx;
  border: 3rpx dashed var(--c-ring);
  background: var(--c-surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.e-plus {
  width: 84rpx;
  height: 84rpx;
}
.empty-banner__txt { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 24rpx; color: var(--c-ink-2); }

.dish-cards { display: flex; flex-wrap: wrap; gap: 20rpx; align-content: flex-start; }
.dish-card { width: 168rpx; position: relative; }
.dish-card__thumb { width: 168rpx; height: 140rpx; border-radius: 28rpx; background: var(--c-track); display: block; }
.dish-card__x {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(61, 42, 30, .6);
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-card__name {
  font-size: 23rpx;
  margin-top: 10rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.add-tile {
  width: 168rpx;
  height: 140rpx;
  border-radius: 28rpx;
  border: 3rpx dashed var(--c-ring);
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-primary);
  font-size: 52rpx;
  line-height: 1;
}
/* 占位＋改为爪印图标 */
.add-tile__img { width: 78rpx; height: 78rpx; }
.dish-card--add .dish-card__name { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; color: var(--c-ink-2); }

.idx-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 24rpx; }
.idx-cell__top { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 23rpx; color: var(--c-ink-2); margin-bottom: 12rpx; }
.idx-bar { height: 16rpx; border-radius: 8rpx; background: var(--c-track); overflow: hidden; }
.idx-bar__fill {
  display: block;
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--c-grad-light), var(--c-primary));
}

/* =========================================================
   ③ 添加页
   ========================================================= */
.sub-header { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 32rpx 8rpx; }
.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--c-line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.back-btn__icon { width: 36rpx; height: 36rpx; }
.sub-header__title {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 400;
}

.add-body { padding: 8rpx 40rpx 80rpx; }
.photo-box {
  margin-top: 24rpx;
  height: 316rpx;
  border-radius: 40rpx;
  border: 4rpx dashed var(--c-ring);
  background: var(--c-surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  color: var(--c-ink-3);
  font-size: 24rpx;
  overflow: hidden;
}
.photo-box__plus {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: var(--c-primary);
  box-shadow: 0 12rpx 28rpx -12rpx rgba(69, 48, 31, .2);
}
.photo-box__img { width: 100%; height: 100%; border-radius: 40rpx; }

.name-edit { margin-top: 32rpx; display: flex; align-items: center; gap: 18rpx; }
.name-edit__nm {
  /* 菜名 = 用户输入 → 系统字体（品牌字体是子集，无法覆盖任意汉字，避免逐字混排） */
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 46rpx;
  font-weight: 400;
}
.name-edit__nm.is-empty { font-size: 32rpx; font-weight: 400; color: var(--c-ink-3); }
.edit-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-line);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.edit-icon__icon { width: 28rpx; height: 28rpx; }

.sec-title {
  margin-top: 40rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
}
.sec-title__hint { margin-left: auto; margin-right: 16rpx; font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 20rpx; font-weight: 400; color: var(--c-ink-3); }
.sec-title__add {
  margin-left: auto;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sec-title__add-img {
  width: 100%;
  height: 100%;
  transition: transform .16s;
}
.sec-title__add:active .sec-title__add-img { transform: scale(.85) rotate(-8deg); }
.sec-title__hint + .sec-title__add { margin-left: 0; }

.ing-chips { margin-top: 20rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  background: var(--c-surface);
  color: var(--c-ink-2);
}
.chip-empty { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 23rpx; color: var(--c-ink-3); }

.step-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--c-surface);
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
}
.step-row__no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--c-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-row__text { flex: 1; font-size: 24rpx; }
/* 用时胶囊：点它改这一步的时长 */
.step-row__time {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  border: 2rpx dashed var(--c-ring);
  background: #fff;
  color: var(--c-ink-2);
  font-size: 23rpx;
  display: flex;
  align-items: center;
}
/* 步骤删除 */
.step-row__del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: var(--c-ink-3);
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-total { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; margin-top: 20rpx; text-align: right; font-size: 24rpx; color: var(--c-ink-2); }
.step-total__b { color: var(--c-primary); font-weight: 700; }

/* 出去吃：地址与导航 */
.addr-box {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--c-line);
  border-radius: 32rpx;
  background: #fff;
}
.addr-line { display: flex; align-items: center; gap: 16rpx; font-size: 26rpx; }
.addr-line__pin { flex-shrink: 0; }
.addr-line__text { flex: 1; min-width: 0; color: var(--c-ink); }
.addr-line__text.is-empty { color: var(--c-ink-3); }
.addr-line__add { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; margin-left: auto; color: var(--c-primary); font-size: 24rpx; flex-shrink: 0; }
.map-mini {
  position: relative;
  margin-top: 20rpx;
  height: 192rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #EDE3D4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.map-mini__img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.nav-tip {
  position: relative;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(69, 48, 31, .82);
  color: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 23rpx;
}

/* 详情态左下角：删除菜品 */
.del-dish-btn {
  position: absolute;
  left: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  height: 100rpx;
  padding: 0 36rpx;
  border-radius: 50rpx;
  z-index: 95;
  border: 2rpx solid var(--c-line);
  background: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  color: #C0392B;
  font-size: 27rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 20rpx 44rpx -16rpx rgba(69, 48, 31, .28);
}
.del-dish-btn__icon { width: 30rpx; height: 30rpx; }

.fab-check {
  position: absolute;
  right: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  height: 100rpx;
  padding: 0 44rpx;
  border-radius: 50rpx;
  z-index: 95;
  background: var(--c-primary);
  color: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 52rpx -12rpx rgba(226, 98, 47, .5);
}

/* 菜名弹窗 */
.modal-mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(26, 15, 8, .45); z-index: 600; }
.name-modal {
  position: absolute;
  left: 50%;
  top: 380rpx;
  transform: translateX(-50%);
  width: 572rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx 36rpx 32rpx;
  z-index: 610;
}
.name-modal__title { font-size: 30rpx; font-weight: 700; text-align: center; }
.name-modal__tip { font-size: 23rpx; color: var(--c-ink-3); text-align: center; margin: 12rpx 0 20rpx; line-height: 1.5; }
.name-modal__input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--c-line);
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #fff;
  color: var(--c-ink);
}
.name-modal__seg { display: flex; gap: 40rpx; margin-top: 24rpx; padding: 0 4rpx; }
.name-modal__seg-item { display: flex; align-items: center; gap: 12rpx; font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 25rpx; color: var(--c-ink-3); }
.name-modal__seg-item.is-on { color: var(--c-ink); font-weight: 400; }
.name-modal__radio { width: 24rpx; height: 24rpx; border-radius: 50%; border: 3rpx solid #DFCEBA; flex-shrink: 0; position: relative; }
.name-modal__seg-item.is-on .name-modal__radio { border-color: var(--c-primary); }
.name-modal__seg-item.is-on .name-modal__radio::after {
  content: '';
  position: absolute;
  left: 3rpx;
  top: 3rpx;
  right: 3rpx;
  bottom: 3rpx;
  border-radius: 50%;
  background: var(--c-primary);
}
.name-modal__btns { display: flex; gap: 20rpx; margin-top: 28rpx; }
.name-modal__btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 27rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
.name-modal__btn--cancel { background: var(--c-surface); color: var(--c-ink-2); }
.name-modal__btn--ok { background: var(--c-primary); color: #fff; font-weight: 400; }

/* ---- 菜名编辑便签：手绘便签纸底，虚线书写感 ---- */
.name-modal.is-note {
  /* 保持基础 absolute 定位；整屏居中（小屏机型如 iPhone6 也不被底部裁切） */
  overflow: hidden;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 604rpx;
  height: 660rpx;
  /* 兜底底色（便签纸米色），即使底图未加载也不穿帮 */
  background: #FDF6EA;
  border-radius: 0;
  padding: 104rpx 76rpx 68rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  filter: drop-shadow(0 44rpx 52rpx rgba(48, 32, 20, .38));
}
/* 便签纸底图：小程序 WXSS 不支持本地背景图，改用绝对定位 image 层铺满 */
.name-modal.is-note .note-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
/* 内容浮在底图之上 */
.name-modal.is-note > view {
  position: relative;
  z-index: 1;
}
.name-modal.is-note .name-modal__title {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #45301F;
  margin-bottom: 8rpx;
}
.name-modal.is-note .name-modal__tip { font-size: 21rpx; color: #B9906F; margin: -4rpx 0 0; }
.name-modal.is-note .name-modal__seg { justify-content: center; margin-top: 48rpx; }
.name-modal.is-note .name-modal__btns { margin-top: 36rpx; gap: 24rpx; }
.name-modal.is-note .name-modal__btn--cancel { background: rgba(226, 98, 47, .10); color: #8A7666; }
.name-modal.is-note .name-modal__btn--ok { box-shadow: 0 16rpx 32rpx -16rpx rgba(226, 98, 47, .6); }
/* 便签输入框：去边框，虚线书写线 + 宋体居中 */
.name-modal.is-note .name-modal__input {
  background: transparent;
  border: none;
  border-bottom: 3rpx dashed #E2A877;
  border-radius: 0;
  height: 68rpx;
  padding: 0 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  text-align: center;
  color: #45301F;
  letter-spacing: 2rpx;
}
/* ---- 画笔光标：画笔落在书写线上（跟随输入内容移动） ---- */
.note-pen {
  position: absolute;
  width: 74rpx;
  height: 92rpx;
  pointer-events: none;
  z-index: 2;
  transform-origin: 87% 7%;         /* 锚点 = 笔尖：旋转 180° 后笔尖钉在定位点上 */
  transform: rotate(180deg);        /* 笔尖朝左下，笔身朝右上 */
}
.note-pen__img {
  width: 100%;
  height: 100%;
  transform-origin: 87% 7%;         /* 锚点 = 笔尖 */
  filter: drop-shadow(0 4rpx 6rpx rgba(69, 48, 31, .22));
  animation: pen-write 2s ease-in-out infinite;
}
/* 写字动画：笔尖沿书写线来回移动 + 轻微摇摆 */
@keyframes pen-write {
  0%   { transform: translate(0, 0) rotate(0deg); }
  18%  { transform: translate(-10rpx, 1rpx) rotate(-2.6deg); }
  38%  { transform: translate(8rpx, 0) rotate(2.2deg); }
  58%  { transform: translate(-12rpx, 1rpx) rotate(-2deg); }
  78%  { transform: translate(6rpx, 0) rotate(1.8deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}
.name-modal__field { position: relative; display: block; }

/* =========================================================
   开屏：静态欢迎图（无动画），停留后直接移除
   ========================================================= */
.splash {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 800;
  overflow: hidden;
  background: var(--c-bg);
}
.splash__img {
  width: 100%;
  height: 100%;
}

/* =========================================================
   ④ 菜单页
   ========================================================= */
.menu-head {
  position: relative;
  z-index: 20;
  background: var(--c-bg);
  padding-bottom: 8rpx;
  box-shadow: 0 24rpx 32rpx -28rpx rgba(61, 42, 30, .4);
}
.search {
  margin: 24rpx 40rpx 0;
  height: 76rpx;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 16rpx;
}
.search__icon { width: 30rpx; height: 30rpx; opacity: .55; }
.search__input { flex: 1; font-size: 26rpx; color: var(--c-ink); }
.seg-line { display: flex; gap: 48rpx; padding: 28rpx 40rpx 4rpx; }
.seg-line__item {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  color: var(--c-ink-2);
  padding: 8rpx 0;
  position: relative;
}
.seg-line__item.is-on { color: var(--c-ink); font-weight: 400; }
.seg-line__item.is-on::after {
  content: '';
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: -4rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
}
.menu-body { display: flex; align-items: flex-start; }
.cat-col { width: 156rpx; padding: 8rpx 8rpx 240rpx; flex-shrink: 0; border-right: 2rpx solid var(--c-line); }
.cat-item {
  padding: 20rpx 4rpx;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 25rpx;
  color: var(--c-ink-2);
  text-align: center;
  border-bottom: 2rpx dashed var(--c-track);
}
.cat-item.is-on { color: var(--c-primary); font-weight: 700; }
.dish-list { flex: 1; padding: 28rpx 28rpx 300rpx 20rpx; }
.dish-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 32rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}
.dish-row__img { width: 104rpx; height: 104rpx; border-radius: 24rpx; background: var(--c-track); flex-shrink: 0; }
.dish-row__info { flex: 1; min-width: 0; }
.dish-row__name { font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif; font-size: 29rpx; font-weight: 600; }
.dish-row__meta { margin-top: 6rpx; font-size: 21rpx; color: var(--c-ink-3); }
.dish-row__tags { margin-top: 8rpx; display: flex; gap: 10rpx; flex-wrap: wrap; }
.sel-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid var(--c-ring);
  background: #fff;
  color: var(--c-ink-2);
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sel-btn.is-on { background: var(--c-primary); border-color: var(--c-primary); color: #fff; font-size: 28rpx; }
.list-empty, .list-hint { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; text-align: center; font-size: 24rpx; color: var(--c-ink-3); padding: 120rpx 20rpx; }

/* 菜单空状态（原型 .menu-empty）：圆形＋ + 「添加菜品/添加美食」+ 副文案 */
.dish-list.is-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;   /* 兜底，JS 量出头部高度后会用精确值覆盖 */
  padding-bottom: 80rpx;
}
.menu-empty { display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.menu-empty__plus {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--c-grad-light), var(--c-primary));
  color: #fff;
  font-size: 62rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 28rpx 56rpx -16rpx rgba(226, 98, 47, .55);
}
.menu-empty__txt {
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 29rpx;
  font-weight: 400;
  color: var(--c-ink-2);
}
.menu-empty__sub { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 23rpx; color: var(--c-ink-3); margin-top: -16rpx; }

.float-bar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  z-index: 95;
  background: var(--c-dark);
  color: #fff;
  border-radius: 52rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 36rpx;
  box-shadow: 0 32rpx 68rpx -16rpx rgba(69, 48, 31, .55);
  font-size: 26rpx;
}
.float-bar__text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; }
.float-bar__go {
  margin-left: auto;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 44rpx;
  background: var(--c-primary);
  color: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
.float-bar__go.is-disabled { background: rgba(255, 255, 255, .15); color: rgba(255, 255, 255, .4); }

/* =========================================================
   ⑤ 引导层（7 步共用一套元素）
   层级：蒙层 600 < 光晕/高亮块 605 < 目标 610 < 脉冲环 612
        < 高亮按钮 614 < 波纹 616 < 箭头 617 < 手势 618 < 气泡 620 < 跳过 621 < toast 622
   ========================================================= */
.g-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 600;
  background: rgba(26, 15, 8, .78);
}
.g-mask.is-soft { background: rgba(26, 15, 8, .58); }

.g-halo {
  position: absolute;
  z-index: 605;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(246, 181, 122, .7) 0%, rgba(226, 98, 47, .34) 46%, rgba(226, 98, 47, 0) 72%);
  animation: g-halo 1.2s ease-in-out infinite;
}
@keyframes g-halo {
  0%, 100% { transform: scale(.96); opacity: .35; }
  50% { transform: scale(1.17); opacity: .95; }
}

.g-block {
  position: absolute;
  z-index: 605;
  pointer-events: none;
  border-radius: 36rpx;
  background: radial-gradient(115% 105% at 50% 50%, rgba(246, 181, 122, .6) 0%, rgba(226, 98, 47, .3) 58%, rgba(226, 98, 47, 0) 100%);
  animation: g-block-breathe 1.6s ease-in-out infinite;
}
@keyframes g-block-breathe {
  0%, 100% { transform: scale(1); opacity: .45; }
  50% { transform: scale(1.035); opacity: 1; }
}

.g-ring {
  position: absolute;
  z-index: 612;
  pointer-events: none;
  border: 4rpx solid rgba(226, 98, 47, .62);
  animation: g-ring 1s cubic-bezier(.2, .7, .3, 1) infinite;
}
@keyframes g-ring {
  0% { transform: scale(.99); opacity: .9; }
  70%, 100% { transform: scale(1.13); opacity: 0; }
}
.g-ring--block { animation-name: g-ring-block; }
@keyframes g-ring-block {
  0% { transform: scale(1); opacity: .95; }
  70%, 100% { transform: scale(1.03); opacity: 0; }
}

.g-rip {
  position: absolute;
  z-index: 616;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, .92);
  pointer-events: none;
  animation: g-rip 2.1s cubic-bezier(.2, .7, .3, 1) .35s infinite;
}
.g-rip--two { animation-delay: .59s; }
@keyframes g-rip {
  0%, 36% { transform: scale(.45); opacity: 0; }
  42% { opacity: .6; }
  66%, 100% { transform: scale(1.5); opacity: 0; }
}

.g-hand {
  position: absolute;
  z-index: 618;
  width: 80rpx;
  height: 92rpx;
  pointer-events: none;
  filter: drop-shadow(0 12rpx 28rpx rgba(20, 10, 4, .55));
}
.g-hand__img { width: 80rpx; height: 92rpx; display: block; }
.g-hand--down { animation: g-hand-down 2.1s cubic-bezier(.35, .1, .4, 1) .35s infinite; }
.g-hand--down .g-hand__img { transform: rotate(155deg); transform-origin: 50% 100%; }
.g-hand--up { animation: g-hand-up 2.1s cubic-bezier(.35, .1, .4, 1) .35s infinite; }
.g-hand--swipe {
  animation: g-hand-swipe 2.6s ease-in-out .3s infinite;
  filter: drop-shadow(0 0 5rpx rgba(61, 42, 30, .5)) drop-shadow(0 12rpx 28rpx rgba(20, 10, 4, .55));
}
.g-hand--bob { animation: g-hand-bob 1.5s ease-in-out infinite; }
@keyframes g-hand-down {
  0% { opacity: 0; transform: translateY(-372rpx) scale(.92); }
  12% { opacity: 1; transform: translateY(-372rpx) scale(1); }
  40% { transform: translateY(0); }
  48% { transform: translateY(-26rpx); }
  56% { transform: translateY(0); }
  64% { transform: translateY(-12rpx); }
  72%, 100% { transform: translateY(0); }
}
@keyframes g-hand-up {
  0% { opacity: 0; transform: translateY(340rpx) scale(.92); }
  12% { opacity: 1; transform: translateY(340rpx) scale(1); }
  40% { transform: translateY(0); }
  48% { transform: translateY(26rpx); }
  56% { transform: translateY(0); }
  64% { transform: translateY(12rpx); }
  72%, 100% { transform: translateY(0); }
}
@keyframes g-hand-swipe {
  0% { opacity: 0; transform: translateY(0); }
  12% { opacity: 1; transform: translateY(0); }
  40% { transform: translateY(260rpx); }
  52% { transform: translateY(260rpx); }
  80% { transform: translateY(0); }
  90% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(0); }
}
@keyframes g-hand-bob {
  0%, 100% { opacity: 1; transform: translateY(0); }
  50% { transform: translateY(-18rpx); }
}

.g-arrow {
  position: absolute;
  z-index: 617;
  width: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  filter: drop-shadow(0 0 4rpx rgba(255, 255, 255, .95)) drop-shadow(0 4rpx 12rpx rgba(20, 10, 4, .35));
  animation: g-arrow-pulse 1.6s ease-in-out .3s infinite;
}
.g-arrow__up, .g-arrow__down { width: 0; height: 0; border-left: 16rpx solid transparent; border-right: 16rpx solid transparent; }
.g-arrow__up { border-bottom: 22rpx solid var(--c-primary); }
.g-arrow__down { border-top: 22rpx solid var(--c-primary); }
.g-arrow__shaft {
  width: 18rpx;
  flex: 1;
  min-height: 52rpx;
  border-radius: 10rpx;
  margin: 4rpx 0;
  background: linear-gradient(180deg, var(--c-grad-light), var(--c-primary));
}
@keyframes g-arrow-pulse { 0%, 100% { opacity: .78; } 50% { opacity: 1; } }

.g-hint {
  position: absolute;
  z-index: 620;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  white-space: nowrap;
  background: rgba(255, 255, 255, .98);
  color: var(--c-primary);
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  box-shadow: 0 24rpx 52rpx -20rpx rgba(20, 10, 4, .7);
  animation: g-hint-in .45s .25s cubic-bezier(.2, .9, .3, 1) both;
}
@keyframes g-hint-in {
  from { opacity: 0; transform: translate(-50%, 20rpx); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
.g-hint--big {
  height: 92rpx;
  padding: 0 12rpx 0 36rpx;
  gap: 24rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  box-shadow: 0 32rpx 68rpx -24rpx rgba(20, 10, 4, .8);
}
.g-inbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: var(--c-primary);
  color: #fff;
  font-size: 25rpx;
  font-weight: 400;
  box-shadow: 0 12rpx 28rpx -12rpx rgba(226, 98, 47, .9);
}
.g-hint--big .g-inbtn { height: 72rpx; padding: 0 32rpx; border-radius: 36rpx; font-size: 28rpx; }

.g-toast {
  position: absolute;
  z-index: 622;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-shadow: 0 2rpx 6rpx rgba(20, 10, 4, .85), 0 12rpx 36rpx rgba(20, 10, 4, .6);
  pointer-events: none;
  transition: opacity .4s ease;
}
.g-toast.is-gone { opacity: 0; }

.g-skip {
  position: absolute;
  z-index: 621;
  right: 32rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, .28);
  background: rgba(255, 255, 255, .14);
  color: rgba(255, 255, 255, .88);
  font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

/* 引导期：目标元素抬到蒙层之上
   g-lift      流内元素：relative + z-index
   g-z614      已经是 absolute/fixed 的元素：只抬 z-index（不能覆盖 position） */
.g-lift { position: relative; z-index: 610; }
.g-lift--btn { position: relative; z-index: 614; }
.g-z614 { z-index: 614; }
.g-glow { animation: g-btn-glow 1s ease-in-out infinite; }
@keyframes g-btn-glow {
  0%, 100% { box-shadow: 0 24rpx 48rpx -12rpx rgba(226, 98, 47, .5), 0 0 0 6rpx rgba(255, 255, 255, 1), 0 0 44rpx 4rpx rgba(226, 98, 47, .9); }
  50% { box-shadow: 0 24rpx 48rpx -12rpx rgba(226, 98, 47, .5), 0 0 0 6rpx rgba(255, 255, 255, .5), 0 0 110rpx 32rpx rgba(226, 98, 47, .25); }
}
/* 奖池引导高亮：仅静态描边（呼吸动画已按需求移除，待机保持纯静态） */
.g-pool-glow { box-shadow: 0 52rpx 104rpx -28rpx rgba(226, 98, 47, .5), 0 0 0 10rpx rgba(255, 255, 255, .8), 0 0 60rpx 8rpx rgba(226, 98, 47, .55); }

/* ===== 标签/食材编辑态 · 步骤拖拽排序 · 附近美食出发图标 BEGIN ===== */

/* 标签 / 食材：长按进入「晃动 + 右上角 ✕」态（不再是长按直接删） */
.ing-chips .chip { position: relative; }
.chip.is-shake { animation: chip-shake .42s ease-in-out infinite; }
@keyframes chip-shake {
  0%, 100% { transform: rotate(-2.4deg) translateY(-2rpx); }
  50% { transform: rotate(2.4deg) translateY(2rpx); }
}
.chip__del {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--c-primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FAF3E9;
  box-shadow: 0 3rpx 8rpx rgba(226, 98, 47, .45);
}

/* 做菜步骤：长按整行上下拖动换序 */
.step-row { transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease; }
.step-row.is-static { opacity: .42; }
.step-row.is-drop { opacity: 1; box-shadow: 0 0 0 3rpx var(--c-primary); }
.step-row.is-dragging {
  position: relative;
  z-index: 30;
  background: #fff;
  opacity: 1;
  box-shadow: 0 22rpx 44rpx -14rpx rgba(69, 48, 31, .45);
  transition: none;
}

/* 附近美食：选择按钮里的手绘纸飞机（替换 ➤ 字形，保证几何居中） */
.sel-btn__ico { width: 36rpx; height: 36rpx; display: block; }

/* ===== 标签/食材编辑态 · 步骤拖拽排序 · 附近美食出发图标 END ===== */

/* ===== BRAND FONT (base64, 由 make-brand-font-wxss.js 生成) BEGIN ===== */
/* 品牌标题字体：站酷快乐体 ZCOOL KuaiLe Regular（SIL Open Font License 1.1，免费商用、可再分发）。
   子集化后 woff2 52KB / ttf 85KB，这里以 base64 内联：不走网络请求，
   因此不受「downloadFile 合法域名 / CORS / iOS 对 woff2 的兼容差 / 真机网络策略」影响，
   开发者工具与 iOS、Android 真机表现一致，也不会产生取字体失败的网络报错。
   更新方式：把新文案加进 make-font-subset.py 的 TEXTS 重跑子集化，再跑 make-brand-font-wxss.js。
   注意：只有 Regular 一个字重 —— 用到该字体family的规则不要再设 font-weight 600/700，否则会伪加粗变形。 */
@font-face {
  font-family: 'ZCOOL KuaiLe';
  src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
       url('data:font/ttf;charset=utf-8;base64,') format('truetype');
  font-style: normal;
}
/* ===== BRAND FONT END ===== */
