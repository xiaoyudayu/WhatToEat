/* 菜单页：样式主体在 app.wxss，这里只放本页特有项 */

.ph { color: #BBA896; }

/* ================= 备菜清单弹框（T1 · R30 定稿） ================= */

.prep-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(69, 48, 31, .34); z-index: 120;
  opacity: 0; pointer-events: none; transition: opacity .22s;
}
.prep-mask.is-on { opacity: 1; pointer-events: auto; }

/* 面板：固定高 540px(1080rpx)，低屏兜底压缩；纸 = 三切片（顶/中平铺/底） */
.prep {
  position: fixed; left: 24rpx; right: 24rpx;
  bottom: calc(310rpx + env(safe-area-inset-bottom));
  height: 1080rpx;
  max-height: calc(100vh - 360rpx - env(safe-area-inset-bottom));
  z-index: 130; display: none;
}
.prep.is-on { display: block; }

.prep__paper-top { position: absolute; left: 0; top: 0; width: 100%; height: 220rpx; }
.prep__paper-bot { position: absolute; left: 0; bottom: 0; width: 100%; height: 309rpx; }
.prep__paper-mid {
  position: absolute; left: 0; right: 0; top: 218rpx; bottom: 307rpx;
  background-image: url("data:image/png;base64,");
  background-repeat: repeat-y; background-size: 100% auto;
}

/* 内容安全区：避开胶带(上) / 卷角(下) / 毛边虚线框(左右) */
.prep__inner {
  position: absolute; left: 68rpx; right: 68rpx; top: 100rpx; bottom: 112rpx;
  display: flex; flex-direction: column; min-height: 0;
}

/* 标题严格居中；「收起」保持间距、随标题右移 */
.prep__head {
  position: relative; height: 48rpx; flex-shrink: 0;
  display: flex; justify-content: center; align-items: center;
}
.prep__title { font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; color: var(--c-ink); }
.prep__close {
  position: absolute; left: calc(50% + 108rpx); top: 50%; transform: translateY(-46%);
  font-size: 22rpx; color: #BBA896; white-space: nowrap;
}

.prep__tabs { display: flex; gap: 12rpx; margin-top: 24rpx; flex-shrink: 0; }
.prep-tab {
  flex: 1; background: rgba(255, 255, 255, .62); border: 1rpx solid var(--c-line);
  border-radius: 24rpx; padding: 12rpx 4rpx 14rpx; text-align: center;
  transition: background .18s, box-shadow .18s;
}
.prep-tab__k { font-size: 20rpx; color: #BBA896; white-space: nowrap; }
.prep-tab__v { font-size: 28rpx; font-weight: 600; color: var(--c-ink); margin-top: 2rpx; line-height: 1.15; }
.prep-tab__v .u { font-size: 18rpx; color: #BBA896; margin-left: 2rpx; }
.prep-tab.is-on {
  background: var(--c-primary); border-color: var(--c-primary);
  box-shadow: 0 8rpx 24rpx -8rpx rgba(226, 98, 47, .6);
}
.prep-tab.is-on .prep-tab__k { color: rgba(255, 255, 255, .8); }
.prep-tab.is-on .prep-tab__v { color: #fff; }
.prep-tab.is-on .prep-tab__v .u { color: rgba(255, 255, 255, .75); }

.prep__scroll {
  position: relative; flex: 1; min-height: 0; margin-top: 22rpx; padding-bottom: 12rpx;
  -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 28rpx, #000 calc(100% - 44rpx), transparent 100%);
  mask-image: linear-gradient(180deg, transparent 0, #000 28rpx, #000 calc(100% - 44rpx), transparent 100%);
}

.prep__blk {
  font-size: 24rpx; color: #8A7666; margin: 24rpx 0 14rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.prep__blk-sub { color: #BBA896; font-size: 20rpx; }

/* 食材合计 */
.prep__ings { display: flex; flex-wrap: wrap; gap: 12rpx; }
.prep__ing {
  background: rgba(255, 255, 255, .8); border: 1rpx solid var(--c-line);
  border-radius: 40rpx; padding: 6rpx 20rpx; font-size: 22rpx; color: var(--c-ink);
}
.prep__ing-x { color: var(--c-primary); font-size: 20rpx; margin-left: 4rpx; }
.prep__empty { font-size: 22rpx; color: #BBA896; padding: 8rpx 0; }

/* 一道一道做：按菜分组，默认全展开可折叠 */
.prep__grp {
  background: rgba(255, 252, 246, .86); border: 1rpx solid var(--c-line);
  border-radius: 28rpx; margin-bottom: 16rpx; overflow: hidden;
}
.prep__grp.is-open { border-color: rgba(226, 98, 47, .45); }
.prep__grp-hd { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 20rpx; }
.prep__grp-img { width: 68rpx; height: 68rpx; border-radius: 18rpx; flex-shrink: 0; background: var(--c-surface); }
.prep__grp-info { flex: 1; min-width: 0; }
.prep__grp-nm { font-size: 26rpx; font-weight: 600; color: var(--c-ink); }
.prep__grp-mt { font-size: 20rpx; color: #BBA896; margin-top: 4rpx; }
.prep__chev {
  width: 0; height: 0; border-left: 10rpx solid transparent; border-right: 10rpx solid transparent;
  border-top: 12rpx solid #BBA896; transition: transform .22s;
}
.prep__grp.is-open .prep__chev { transform: rotate(180deg); border-top-color: var(--c-primary); }
.prep__grp-bd { padding: 0 20rpx 20rpx; }

/* 步骤行 / 交叉备菜行 */
.prep__step {
  display: flex; align-items: center; gap: 16rpx;
  background: rgba(255, 255, 255, .7); border: 1rpx solid var(--c-line);
  border-radius: 20rpx; padding: 12rpx 18rpx; margin-bottom: 10rpx;
}
.prep__step.is-wait { border-style: dashed; background: transparent; }
.prep__step-no {
  width: 34rpx; height: 34rpx; flex-shrink: 0; border-radius: 50%;
  background: rgba(250, 224, 204, .95); color: var(--c-primary); font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.prep__step-tx { font-size: 23rpx; color: var(--c-ink); flex: 1; line-height: 1.4; }
.prep__step-dish { font-weight: 600; }
.prep__tag {
  font-size: 20rpx; color: var(--c-primary); background: rgba(250, 224, 204, .85);
  border-radius: 20rpx; padding: 4rpx 16rpx; flex-shrink: 0;
}
.prep__cross-note { font-size: 21rpx; color: #BBA896; margin-bottom: 14rpx; line-height: 1.5; }

/* 本餐菜品卡片 */
.prep__dcard {
  display: flex; gap: 20rpx; background: rgba(255, 252, 246, .86);
  border: 1rpx solid var(--c-line); border-radius: 28rpx; padding: 20rpx; margin-bottom: 16rpx;
}
.prep__dcard-img { width: 128rpx; height: 128rpx; border-radius: 22rpx; flex-shrink: 0; background: var(--c-surface); }
.prep__dcard-info { flex: 1; min-width: 0; }
.prep__dcard-nm { font-size: 28rpx; font-weight: 600; color: var(--c-ink); }
.prep__dcard-mt { font-size: 21rpx; color: #BBA896; margin-top: 6rpx; }
.prep__dcard-ings { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.prep__dcard-ings text {
  font-size: 20rpx; color: #8A7666; background: rgba(240, 226, 206, .75);
  border-radius: 16rpx; padding: 2rpx 12rpx;
}

/* 分享按钮：白猫爪 + 橙底胶囊，宽度自适应居中 */
.prep__share {
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
  width: max-content; margin: 28rpx auto 12rpx; height: 88rpx; padding: 0 44rpx;
  border-radius: 44rpx; background: var(--c-primary); color: #fff;
  font-size: 27rpx; font-weight: 600;
  box-shadow: 0 12rpx 32rpx -16rpx rgba(226, 98, 47, .85);
}
.prep__share-paw { width: 56rpx; height: 60rpx; }
.prep__share:active { transform: scale(.98); }

/* ================= 分享长图预览 ================= */

.poster-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(45, 30, 18, .62); z-index: 140;
  display: none; flex-direction: column; align-items: center;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}
.poster-mask.is-on { display: flex; }
.poster__bar {
  width: 100%; display: flex; justify-content: space-between; align-items: center;
  color: #F5E4CE; font-size: 26rpx; padding: 0 8rpx 20rpx;
}
.poster__close { color: #BBA896; font-size: 24rpx; }
.poster__img { flex: 1; min-height: 0; width: 100%; border-radius: 24rpx; }
.poster__acts { display: flex; gap: 24rpx; width: 100%; padding-top: 28rpx; }
.poster__btn {
  flex: 1; height: 88rpx; border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
}
.poster__btn.is-ghost { background: rgba(255, 255, 255, .16); color: #F5E4CE; }
.poster__btn.is-primary { background: var(--c-primary); color: #fff; }

/* 长图绘制画布（离屏，仅作绘制缓冲） */
.poster-canvas {
  position: fixed; left: 0; top: 0; width: 750px; height: 750px;
  opacity: 0; pointer-events: none; z-index: -1;
}
