/* 底部导航（组件自带样式：不依赖页面 / app 样式） */
/* 底部渐变过渡：从导航条上缘开始，内容往下滚过导航条区域逐渐隐入底色，
   一直铺到屏幕最底（导航条下方的留白条也是底色效果） */
.tab-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(300rpx + env(safe-area-inset-bottom) * 2);
  background: linear-gradient(to bottom,
    rgba(250, 243, 233, 0),
    rgba(250, 243, 233, .82) 46%,
    #FAF3E9 62%);
  pointer-events: none;
}
.tabbar {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  height: 124rpx;
  background: #fff;
  border: 2rpx solid #EBDBC9;
  border-radius: 62rpx;
  box-shadow: 0 24rpx 60rpx -16rpx rgba(69, 48, 31, .2);
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  /* 刻意不设 z-index：设了会成为层叠上下文，内部 tab 便无法抬到引导蒙层之上 */
}
.tab {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  position: relative;
  background: transparent;
  transition: background .18s;
}
.tab__icon {
  width: 64rpx;
  height: 64rpx;
  filter: drop-shadow(0 4rpx 6rpx rgba(69, 48, 31, .26));
  transition: transform .18s, filter .18s, opacity .18s;
}
.tab__label { font-family: "ZCOOL KuaiLe", "PingFang SC", sans-serif; font-size: 20rpx; line-height: 1; color: #BBA896; transition: color .18s; }
/* IP 萌宠风格：淡橙选中态（无边框），图标轻微放大 */
.tab.is-active { background: rgba(226, 98, 47, .11); }
.tab.is-active .tab__icon {
  transform: scale(1.06);
  filter: drop-shadow(0 6rpx 12rpx rgba(226, 98, 47, .34));
}
.tab.is-active .tab__label { color: #E2622F; font-weight: 400; }

.tab--add { background: transparent !important; }
.tab--add .tab__fab {
  position: absolute;
  left: 50%;
  top: -40rpx;
  transform: translateX(-50%);
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #F6B57A, #E2622F);
  box-shadow: 0 20rpx 40rpx -10rpx rgba(226, 98, 47, .5), 0 0 0 6rpx #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab--add .tab__plus { position: relative; width: 32rpx; height: 32rpx; }
.tab--add .tab__plus::before,
.tab--add .tab__plus::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 3rpx;
}
.tab--add .tab__plus::before { left: 0; top: 50%; width: 100%; height: 5rpx; margin-top: -2.5rpx; }
.tab--add .tab__plus::after { top: 0; left: 50%; height: 100%; width: 5rpx; margin-left: -2.5rpx; }
.tab--add .tab__label { position: absolute; left: 0; right: 0; top: 57rpx; text-align: center; }

/* 引导期：把某个 tab 抬到蒙层（z-index 600）之上 */
.g-lift { position: relative; z-index: 610; }
